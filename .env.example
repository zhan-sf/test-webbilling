# Billing HTTP API 地址。Vite 会将浏览器的 /api 请求代理到这里。
PAYMENT_API_TARGET=http://localhost:8888

# 本地 HTTPS 使用自签名证书时可设为 false；默认保持证书校验。
PAYMENT_API_TLS_VERIFY=true

# MD.Web.API 地址。HAP 的账务查询会通过 /mdapi 代理到这里。
MD_WEB_API_TARGET=http://localhost

# MD.Web.API 使用自签名 HTTPS 证书时可设为 false。
MD_WEB_API_TLS_VERIFY=true
